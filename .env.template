# LLM Provider (openai | gemini)
AML_LLM_PROVIDER=

# API Keys
AML_OPENAI_API_KEY=
AML_GEMINI_API_KEY=

# Model overrides (optional)
AML_LLM_MODEL_TRIAGE=
AML_LLM_MODEL_SAR=

# Observability (none | langfuse)
OBSERVABILITY_PROVIDER=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
OTEL_TRACES_EXPORTER=none

# Authentication
AML_API_KEY=

# CORS (comma-separated origins; set to * for wide open)
# AML_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Data privacy — mask counterparty names sent to LLM APIs
AML_ANONYMIZE_LLM_DATA=false

# Database (optional — defaults to data/aml.db)
# AML_DATABASE_URL=sqlite+aiosqlite:///data/aml.db

# LLM Timeout (seconds, per-call; default 120)
# AML_LLM_TIMEOUT=120

# LLM Budget (USD, per-upload; 0 = unlimited)
# AML_LLM_BUDGET=0